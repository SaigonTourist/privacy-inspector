# Cloudflare R2 — credenciales de subida (scripts/upload-to-r2.ts)
# Crea un API token en https://dash.cloudflare.com/profile/api-tokens
# con permiso R2:Edit sobre tu bucket.
CF_ACCOUNT_ID=tu_cloudflare_account_id
CF_API_TOKEN=tu_api_token_con_r2_edit
R2_BUCKET_NAME=privacy-inspector-trackers

# URL pública del bucket R2 (permite que la extensión descargue actualizaciones).
# Activa "Public Access" en el bucket → obtendrás una URL tipo:
#   https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# O conéctale un dominio personalizado desde R2 → Settings → Custom Domains.
PLASMO_PUBLIC_TRACKERS_URL=https://pub-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.dev

# URL del Cloudflare Worker (backend de análisis con IA — Fase 2).
# Tras hacer `cd backend && wrangler deploy` obtendrás una URL tipo:
#   https://privacy-inspector-api.<tu-subdominio>.workers.dev
PLASMO_PUBLIC_ANALYZE_URL=https://privacy-inspector-api.XXXXXXXX.workers.dev
